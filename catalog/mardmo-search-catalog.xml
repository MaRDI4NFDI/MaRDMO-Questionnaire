		<uri_path>mardmo-search-catalog</uri_path>
		<dc:comment/>
		<order>0</order>
		<title lang="en">MaRDMO: Search Interdisciplinary Workflows, Mathematical Models and Algorithms</title>
		<help lang="en">&lt;p&gt;Searches the MaRDI Portal for mathematical models, algorithms and interdisciplinary workflows by the entries they are linked to and by keywords, without any knowledge of SPARQL.&lt;/p&gt;&lt;p&gt;The video &lt;a href="https://youtu.be/hd3PrlPV3EA"&gt;MaRDMO Search&lt;/a&gt; shows how a query is built and run.&lt;/p&gt;</help>
		<title lang="de">MaRDMO: Suche interdisziplinäre Workflows, mathematisches Modelle und Algorithmen</title>
		<help lang="de">&lt;p&gt;Durchsucht das MaRDI Portal nach mathematischen Modellen, Algorithmen und interdisziplinären Workflows, über die Einträge, mit denen sie verknüpft sind, und über Schlagworte, ohne SPARQL-Kenntnisse.&lt;/p&gt;&lt;p&gt;Das Video &lt;a href="https://youtu.be/hd3PrlPV3EA"&gt;MaRDMO Search&lt;/a&gt; zeigt, wie eine Abfrage gebaut und ausgeführt wird.&lt;/p&gt;</help>
		<sections>
			<section dc:uri="https://rdmo.mardi4nfdi.de/terms/questions/mardmo/search" order="0"/>
		</sections>
	</catalog>
